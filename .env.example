# ---------------------------------------------------------------------
# Copy this file to .env.local for local development.
# On Render, add the same keys under Environment → Environment Variables.
# ---------------------------------------------------------------------

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://iphoneduowallpaper.com

# ---------------- Supabase (Project Settings → API) ----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) or the legacy "service_role" key — server only, never expose
SUPABASE_SECRET_KEY=

# ---------------- Cloudflare R2 (R2 → Manage API tokens) ----------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=iphoneduowallpaper
# Public bucket URL: custom domain (recommended) or the r2.dev URL, no trailing slash
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.iphoneduowallpaper.com

# ---------------- Security ----------------
# Any long random string (used to hash visitor IPs for rate limiting)
IP_HASH_SALT=change-me-to-a-long-random-string
